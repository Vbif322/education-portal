# Строка подключения к PostgreSQL.
# Значение по умолчанию совпадает с docker-compose.yml.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/education_portal

# Секрет для подписи JWT-сессий (cookie).
# Сгенерировать: openssl rand -base64 32
SESSION_SECRET=change-me

# ID счётчика Яндекс.Метрики (опционально).
NEXT_PUBLIC_YANDEX_METRIKA_ID=

# Стартовый администратор, создаётся командой `npm run db:seed`.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin12345

# SMTP для отправки заявок с /business.
# Без этих переменных форма показывает контакты вместо отправки,
# а содержимое заявки пишется в лог сервера.
SMTP_HOST=smtp.mail.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
# Пароль приложения, не пароль от ящика.
# Значение пишется без комментария в той же строке — некоторые загрузчики
# утащат его в пароль целиком.
SMTP_PASSWORD=
# Должен совпадать с SMTP_USER.
EMAIL_FROM=
EMAIL_TO=admin@example.com
# Имя отправителя в поле From. Необязательно, по умолчанию — название сайта.
EMAIL_FROM_NAME=
