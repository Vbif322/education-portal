# Строка подключения к PostgreSQL.
# Значение по умолчанию совпадает с docker-compose.yml.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/education_portal

# Секрет для подписи JWT-сессий (cookie).
# Сгенерировать: openssl rand -base64 32
SESSION_SECRET=change-me

# ID счётчика Яндекс.Метрики (опционально).
NEXT_PUBLIC_YANDEX_METRIKA_ID=

# Публичный адрес сайта для ссылок в письмах (сброс пароля, вход по ссылке).
# Читается только на сервере, поэтому меняется рестартом, без пересборки —
# в отличие от NEXT_PUBLIC_SITE_URL ниже, который служит фолбэком.
# Без обеих переменных в production письма со ссылками НЕ отправляются:
# подставлять базу из заголовка Host нельзя (захват аккаунта через host header).
APP_URL=

# Публичный адрес сайта без слеша на конце, например https://example.ru
# Нужен для og:image и canonical на страницах курсов: мессенджеры и поисковики
# требуют абсолютных ссылок. Без него Next подставит localhost.
# Как и любая NEXT_PUBLIC_*, вшивается на этапе сборки — после смены нужен
# `npm run build`, перезапуска мало.
NEXT_PUBLIC_SITE_URL=

# Стартовый администратор, создаётся командой `npm run db:seed`.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin12345

# SMTP для заявок с /business и транзакционных писем (сброс пароля,
# вход по ссылке).
# Без этих переменных форма заявки показывает контакты вместо отправки
# (содержимое пишется в лог сервера), а восстановление доступа не работает.
SMTP_HOST=smtp.mail.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
# Пароль приложения, не пароль от ящика.
# Значение пишется без комментария в той же строке — некоторые загрузчики
# утащат его в пароль целиком.
SMTP_PASSWORD=
# Должен совпадать с SMTP_USER.
EMAIL_FROM=
# Получатель заявок с сайта. На транзакционные письма не влияет: у них
# получатель — сам пользователь.
EMAIL_TO=admin@example.com
# Имя отправителя в поле From. Необязательно, по умолчанию — название сайта.
EMAIL_FROM_NAME=
