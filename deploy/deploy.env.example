# Настройки scripts/deploy.sh.
#
# Скопировать на сервере в корень чекаута как `.deploy.env` (файл gitignored)
# и оставить только те строки, где значение отличается от значения по умолчанию.
# Любую переменную можно задать и через окружение при запуске.

# Каталог чекаута. По умолчанию — родительский каталог scripts/,
# то есть менять почти никогда не нужно.
#APP_DIR=/srv/education-portal

# Ветка и remote, с которых обновляемся.
#BRANCH=master
#REMOTE=origin

# Имя systemd-юнита приложения.
#UNIT=education-portal

# Файл с переменными окружения приложения (DATABASE_URL, SESSION_SECRET, …).
#ENV_FILE=/srv/education-portal/.env

# Каталог состояния скрипта: логи, файл блокировки, история деплоев.
#STATE_DIR=/srv/education-portal/.deploy
#LOG_DIR=/srv/education-portal/.deploy/logs

# Порт приложения. Должен совпадать с апстримом в nginx:
# `npm run start` слушает 3000, `npm run start:prod` — 9000.
#APP_PORT=3000

# Полный URL проверки живости и таймаут ожидания после рестарта.
#HEALTH_URL=http://127.0.0.1:3000/api/health
#HEALTH_TIMEOUT=90

# Минимум свободного места в каталоге приложения, ГБ.
#MIN_FREE_GB=4

# --- Способ управления сервисом -------------------------------------------
#
# По умолчанию юнит системный, а скрипт запускается не от root, поэтому
# рестарт идёт через sudo. Нужна узкая запись в sudoers:
#
#   deploy ALL=(root) NOPASSWD: /usr/bin/systemctl restart education-portal, \
#                               /usr/bin/journalctl -u education-portal *
#
#SYSTEMCTL_CMD="sudo systemctl"
#SYSTEMCTL_RO_CMD="systemctl"
#JOURNALCTL_CMD="sudo journalctl"
#
# Если приложение работает под user-юнитом (systemctl --user), sudo не нужен:
#
#SYSTEMCTL_CMD="systemctl --user"
#SYSTEMCTL_RO_CMD="systemctl --user"
#JOURNALCTL_CMD="journalctl --user"
